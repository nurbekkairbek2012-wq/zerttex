# Optional: switch Tulpar from the offline demo engine to Google Gemini.
# Set these ONLY in the hosting provider (Netlify -> Site configuration -> Environment variables).
# Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative (used only when GEMINI_API_KEY is empty): Claude.
ANTHROPIC_API_KEY=
TULPAR_MODEL=claude-haiku-5-5
